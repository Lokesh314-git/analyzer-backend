# ==============================================================================
# Semester Marks Analytics Platform - Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development, or configure these variables
# directly in the Render Dashboard for your deployed services.
#
# ARCHITECTURE OVERVIEW:
# 1. Frontend: Render Static Site (React 18 + Vite)
# 2. Backend:  Render Web Service (Node.js 20+ / Express)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND WEB SERVICE ENVIRONMENT VARIABLES (Render Web Service)
# ------------------------------------------------------------------------------
# Server Environment & Port (Render sets PORT dynamically; defaults to 5000 locally)
NODE_ENV=production
PORT=5000

# CORS Allowed Origin
# Set to your deployed Render Static Site URL (e.g. https://semester-marks-analytics.onrender.com)
# Multiple origins may be separated by commas (e.g. https://domain1.com,https://domain2.com)
FRONTEND_URL=https://semester-marks-analytics.onrender.com

# Google Sheets Single Source of Truth
# Format: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1EAvs5Do15sVTqKk6vuCgEBrHdsZFXZaHhOapyHFAPJY/edit?usp=sharing
SPREADSHEET_ID=1EAvs5Do15sVTqKk6vuCgEBrHdsZFXZaHhOapyHFAPJY

# Optional Worksheet Tab GID (Defaults to first tab if omitted)
# WORKSHEET_GID=0

# Optional Google Apps Script Web App Bridge (for restricted corporate/institutional sheets)
# APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx.../exec
# APPS_SCRIPT_TOKEN=your-pre-shared-token-here # SENSITIVE: Never commit real token

# ------------------------------------------------------------------------------
# 2. FRONTEND STATIC SITE ENVIRONMENT VARIABLES (Render Static Site)
# ------------------------------------------------------------------------------
# Public API Base URL
# Set this in your Render Static Site environment to point to your deployed backend
# (e.g. https://semester-marks-backend.onrender.com)
# In local development, leave empty to route via Vite dev proxy.
VITE_API_BASE_URL=https://semester-marks-backend.onrender.com

