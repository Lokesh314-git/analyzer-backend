# ==============================================================================
# Semester Marks Analytics Platform - Backend Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Security & CORS
# Set to your deployed Render Static Site domain (e.g. https://semester-marks-analytics.onrender.com)
# Multiple origins can be separated by commas (e.g. https://custom-domain.com,https://preview.onrender.com)
FRONTEND_URL=https://semester-marks-analytics.onrender.com

# Google Sheets Data Source (Single Source of Truth)
# Public CSV export or authorized sheet URL
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1EAvs5Do15sVTqKk6vuCgEBrHdsZFXZaHhOapyHFAPJY/edit?usp=sharing
SPREADSHEET_ID=1EAvs5Do15sVTqKk6vuCgEBrHdsZFXZaHhOapyHFAPJY
# WORKSHEET_GID=0

# Optional Google Apps Script Web App Bridge (for authenticated corporate/private sheets)
# APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx.../exec
# APPS_SCRIPT_TOKEN=your-secure-pre-shared-token-here # SENSITIVE: Never commit real token

