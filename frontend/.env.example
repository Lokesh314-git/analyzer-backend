# Base URL of the backend Web Service API.
# - In local development: Leave blank to route through Vite dev server proxy (http://localhost:5000)
# - In Render production: Set to the URL of the deployed backend Web Service (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=https://semester-marks-backend.onrender.com

